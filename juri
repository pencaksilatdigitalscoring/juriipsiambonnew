<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>BRONZE DIGITAL SCORING - Panel Juri</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap');
        body { font-family: 'Montserrat', sans-serif; background-color: #f8fafc; color: #1e293b; margin: 0; height: 100vh; width: 100vw; overflow: hidden; }
        
        .screen { display: none; height: 100vh; width: 100vw; flex-direction: column; position: absolute; top: 0; left: 0; background: #f8fafc; }
        .screen.active { display: flex; }

        .sudut-merah-bg { background-color: #ef4444; color: white; }
        .sudut-biru-bg { background-color: #3b82f6; color: white; }

        .modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.9); z-index: 10000; display: none; align-items: center; justify-content: center; padding: 20px; backdrop-filter: blur(4px); }
        .modal-overlay.active { display: flex; }
        
        .circle-vote { width: 70px; height: 70px; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; font-weight: 900; color: white; border: 4px solid rgba(0,0,0,0.1); border-bottom-width: 6px; position: relative; top: 0; transition: all 0.2s; font-size: 8px; text-transform: uppercase; }
        .circle-active { border: 6px solid #1e293b !important; box-shadow: 0 0 25px rgba(0,0,0,0.4); transform: scale(1.1); }
        .jr-vote-locked { pointer-events: none; opacity: 0.6; }
        .jr-vote-selected { opacity: 1 !important; }

        .jr-hit-btn { transition: all 0.05s; }
        .jr-hit-btn:active { background-color: #fbbf24 !important; color: #000 !important; box-shadow: 0 0 30px #fbbf24 !important; transform: scale(0.95); }
        .jr-hit-btn-off { background-color: #64748b !important; opacity: 0.5 !important; pointer-events: none !important; border-bottom: none !important; }

        .juri-lamp { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-left: 5px; border: 1px solid rgba(0,0,0,0.1); }
        .juri-lamp-red { background-color: #ef4444; box-shadow: 0 0 5px #ef4444; }
        .juri-lamp-green { background-color: #10b981; box-shadow: 0 0 5px #10b981; }

        .btn-rotate-mini { width: 28px; height: 28px; background: rgba(255,255,255,0.1); color: white; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 12px; border: 1px solid rgba(255,255,255,0.2); transition: background 0.2s;}
        .btn-rotate-mini:active { transform: scale(0.9); }

        @keyframes slideInDown { from { transform: translate3d(0, -100%, 0); visibility: visible; } to { transform: translate3d(0, 0, 0); } }
        .juri-alert-ani { animation: slideInDown 0.5s ease-out; }

        /* Custom Scrollbar */
        .custom-scrollbar::-webkit-scrollbar { width: 4px; height: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(0,0,0,0.1); border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 4px; }
    </style>
</head>
<body>

    <!-- JURI SELECTION -->
    <div id="screen-juri-select" class="screen p-8 justify-center items-center">
        <div id="juri-alert-box" class="fixed top-10 left-0 right-0 z-[60000] flex justify-center pointer-events-none opacity-0 transition-opacity">
            <div class="bg-red-600 text-white px-8 py-4 rounded-full font-black uppercase text-xs shadow-2xl juri-alert-ani flex items-center gap-3">
                <i class="fas fa-exclamation-triangle"></i> JURI SUDAH MASUK
            </div>
        </div>
        <div class="mb-8 text-center">
            <h2 class="text-2xl font-black uppercase text-blue-600 italic">Panel Penilaian Juri</h2>
        </div>
        <div class="grid grid-cols-1 gap-4 w-full max-w-xs">
            <button onclick="initJuri(1)" class="p-6 bg-white border-2 border-blue-500 rounded-3xl font-black text-blue-600 shadow-lg text-lg uppercase italic flex items-center justify-center gap-4">Juri 1 <div id="select-lamp-j1" class="juri-lamp juri-lamp-red"></div></button>
            <button onclick="initJuri(2)" class="p-6 bg-white border-2 border-blue-500 rounded-3xl font-black text-blue-600 shadow-lg text-lg uppercase italic flex items-center justify-center gap-4">Juri 2 <div id="select-lamp-j2" class="juri-lamp juri-lamp-red"></div></button>
            <button onclick="initJuri(3)" class="p-6 bg-white border-2 border-blue-500 rounded-3xl font-black text-blue-600 shadow-lg text-lg uppercase italic flex items-center justify-center gap-4">Juri 3 <div id="select-lamp-j3" class="juri-lamp juri-lamp-red"></div></button>
        </div>
        <button onclick="window.location.href='index.html'" class="mt-8 text-slate-400 font-bold uppercase text-[10px] tracking-widest"><i class="fas fa-arrow-left mr-2"></i> KEMBALI KE MENU UTAMA</button>
    </div>

    <!-- JURI PANEL -->
    <div id="screen-juri" class="screen bg-slate-900">
        
        <!-- MODAL VAR -->
        <div id="jr-var-overlay" class="modal-overlay">
            <div class="bg-white rounded-[3rem] p-8 w-full max-w-md shadow-2xl border-4 border-blue-500 text-center relative overflow-hidden">
                <div class="absolute top-0 left-0 right-0 h-2 bg-blue-500"></div>
                <h3 class="font-black text-blue-600 italic text-xl mb-1">V A R</h3>
                <p id="jr-var-header" class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-4 border-b border-slate-100 pb-2">---</p>
                <div class="flex justify-between items-center mb-8 px-2 gap-2"><div class="flex-1"><p id="jr-var-b-name" class="text-blue-600 font-black text-[12px] uppercase leading-tight mb-1 truncate">---</p><p id="jr-var-b-kont" class="text-blue-400 font-bold text-[8px] uppercase italic truncate">---</p></div><div class="font-black text-slate-300 italic text-xs">VS</div><div class="flex-1"><p id="jr-var-m-name" class="text-red-600 font-black text-[12px] uppercase leading-tight mb-1 truncate">---</p><p id="jr-var-m-kont" class="text-red-400 font-bold text-[8px] uppercase italic truncate">---</p></div></div>
                <div id="jr-vote-container" class="grid grid-cols-3 gap-4 w-full"><button id="jr-vote-biru" onclick="sendVarVote('biru')" class="circle-vote bg-blue-600 active:scale-95 shadow-lg border-4 border-blue-100"><i class="fas fa-check text-xl mb-1"></i>BIRU</button><button id="jr-vote-merah" onclick="sendVarVote('merah')" class="circle-vote bg-red-600 active:scale-95 shadow-lg border-4 border-red-100"><i class="fas fa-check text-xl mb-1"></i>MERAH</button><button id="jr-vote-kuning" onclick="sendVarVote('kuning')" class="circle-vote bg-yellow-500 active:scale-95 shadow-lg border-4 border-yellow-100"><i class="fas fa-times text-xl mb-1"></i>INVALID</button></div>
                <p class="mt-8 text-[7px] font-black text-slate-300 uppercase italic">*Pilihan akan terkunci setelah diklik</p>
            </div>
        </div>
        
        <!-- Header Top -->
        <div class="p-3 flex justify-between items-center border-b border-white/10 bg-slate-800">
            <button onclick="exitJuri()" class="text-[9px] font-black text-white bg-red-600 px-4 py-2 rounded-lg shadow-md uppercase italic">EXIT</button>
            <div class="text-center flex-1 mx-2 flex items-center justify-center gap-3">
                <!-- Tombol Landscape/Fullscreen -->
                <button onclick="toggleLandscape()" class="btn-rotate-mini bg-slate-700 hover:bg-slate-600 shadow-md" title="Toggle Layar Penuh">
                    <i class="fas fa-expand"></i>
                </button>
                <div class="flex flex-col text-left">
                    <span id="jr-role-name" class="text-[14px] font-black text-blue-400 block uppercase italic tracking-wider">JURI ---</span>
                    <span id="jr-partai-info" class="text-[8px] font-bold text-gray-300 uppercase italic">---</span>
                </div>
            </div>
            <div class="flex flex-col items-end"><span id="jr-timer-disp" class="text-2xl font-black text-yellow-400 font-mono leading-none">02:00</span><span id="jr-round-badge" class="text-[8px] bg-red-600 text-white px-2 rounded mt-1 font-black">BABAK 1</span></div>
        </div>
        
        <!-- Main Area Sudut & Riwayat (Kolom Tengah) -->
        <div class="flex-1 flex flex-row p-2 gap-2 overflow-hidden">
            <!-- SUDUT BIRU -->
            <div class="flex-1 sudut-biru-bg rounded-[2rem] p-3 md:p-4 flex flex-col border-b-8 border-blue-800 shadow-2xl relative transition-all">
                <div class="flex flex-col items-center mb-3">
                    <p id="jr-b-nama-full" class="text-[11px] font-black uppercase truncate w-full text-center">---</p>
                    <p id="jr-b-kont-full" class="text-[8px] font-bold opacity-80 uppercase truncate w-full text-center">---</p>
                </div>
                <div class="flex-1 flex flex-col gap-3 pb-2">
                    <button id="jr-btn-hit-b1" onclick="sendHitDirect('biru', 1)" class="jr-hit-btn flex-1 bg-white/30 rounded-3xl flex flex-col items-center justify-center shadow-lg active:bg-white active:text-blue-600 transition-all uppercase"><i class="fas fa-hand-fist text-3xl md:text-4xl mb-2"></i><span class="text-[11px] md:text-[12px] font-black tracking-tighter">PUKULAN +1</span></button>
                    <button id="jr-btn-hit-b2" onclick="sendHitDirect('biru', 2)" class="jr-hit-btn flex-1 bg-white/30 rounded-3xl flex flex-col items-center justify-center shadow-lg active:bg-white active:text-blue-600 transition-all uppercase"><i class="fas fa-shoe-prints -rotate-90 text-3xl md:text-4xl mb-2"></i><span class="text-[11px] md:text-[12px] font-black tracking-tighter">TENDANGAN +2</span></button>
                </div>
            </div>

            <!-- RIWAYAT TENGAH -->
            <div class="w-[30%] min-w-[150px] max-w-[280px] bg-slate-800 rounded-[1.5rem] p-3 flex flex-col border-2 border-slate-700 shadow-inner overflow-hidden">
                <div class="text-center font-black text-slate-300 text-[10px] md:text-[11px] uppercase tracking-widest mb-3 border-b border-slate-600 pb-2 flex items-center justify-center gap-2 flex-none">
                    <i class="fas fa-history text-blue-400"></i> Riwayat Poin
                </div>
                
                <div class="flex-1 flex flex-col gap-2 min-h-0 w-full">
                    <!-- Babak 1 -->
                    <div id="hist-box-0" class="bg-slate-700/40 rounded-xl p-2 flex flex-col flex-1 border border-slate-600/50 min-h-0 hidden">
                        <div class="text-[10px] md:text-[12px] text-yellow-400 font-black text-center mb-2 bg-slate-800/80 rounded-full py-1.5 mx-2 border border-slate-600/50 shadow-sm flex-none">BABAK 1</div>
                        <div class="flex flex-row w-full text-[12px] md:text-[14px] leading-relaxed font-mono flex-1 overflow-y-auto custom-scrollbar pr-1 mt-1">
                            <div class="w-1/2 border-r border-slate-500 pr-2 text-right break-words whitespace-normal" id="hist-mid-biru-0">-</div>
                            <div class="w-1/2 pl-2 text-left break-words whitespace-normal" id="hist-mid-merah-0">-</div>
                        </div>
                    </div>
                    <!-- Babak 2 -->
                    <div id="hist-box-1" class="bg-slate-700/40 rounded-xl p-2 flex flex-col flex-1 border border-slate-600/50 min-h-0 hidden">
                        <div class="text-[10px] md:text-[12px] text-yellow-400 font-black text-center mb-2 bg-slate-800/80 rounded-full py-1.5 mx-2 border border-slate-600/50 shadow-sm flex-none">BABAK 2</div>
                        <div class="flex flex-row w-full text-[12px] md:text-[14px] leading-relaxed font-mono flex-1 overflow-y-auto custom-scrollbar pr-1 mt-1">
                            <div class="w-1/2 border-r border-slate-500 pr-2 text-right break-words whitespace-normal" id="hist-mid-biru-1">-</div>
                            <div class="w-1/2 pl-2 text-left break-words whitespace-normal" id="hist-mid-merah-1">-</div>
                        </div>
                    </div>
                    <!-- Babak 3 -->
                    <div id="hist-box-2" class="bg-slate-700/40 rounded-xl p-2 flex flex-col flex-1 border border-slate-600/50 min-h-0 hidden">
                        <div class="text-[10px] md:text-[12px] text-yellow-400 font-black text-center mb-2 bg-slate-800/80 rounded-full py-1.5 mx-2 border border-slate-600/50 shadow-sm flex-none">BABAK 3</div>
                        <div class="flex flex-row w-full text-[12px] md:text-[14px] leading-relaxed font-mono flex-1 overflow-y-auto custom-scrollbar pr-1 mt-1">
                            <div class="w-1/2 border-r border-slate-500 pr-2 text-right break-words whitespace-normal" id="hist-mid-biru-2">-</div>
                            <div class="w-1/2 pl-2 text-left break-words whitespace-normal" id="hist-mid-merah-2">-</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- SUDUT MERAH -->
            <div class="flex-1 sudut-merah-bg rounded-[2rem] p-3 md:p-4 flex flex-col border-b-8 border-red-800 shadow-2xl relative transition-all">
                <div class="flex flex-col items-center mb-3">
                    <p id="jr-m-nama-full" class="text-[11px] font-black uppercase truncate w-full text-center">---</p>
                    <p id="jr-m-kont-full" class="text-[8px] font-bold opacity-80 uppercase truncate w-full text-center">---</p>
                </div>
                <div class="flex-1 flex flex-col gap-3 pb-2">
                    <button id="jr-btn-hit-m1" onclick="sendHitDirect('merah', 1)" class="jr-hit-btn flex-1 bg-white/30 rounded-3xl flex flex-col items-center justify-center shadow-lg active:bg-white active:text-red-600 transition-all uppercase"><i class="fas fa-hand-fist text-3xl md:text-4xl mb-2"></i><span class="text-[11px] md:text-[12px] font-black tracking-tighter">PUKULAN +1</span></button>
                    <button id="jr-btn-hit-m2" onclick="sendHitDirect('merah', 2)" class="jr-hit-btn flex-1 bg-white/30 rounded-3xl flex flex-col items-center justify-center shadow-lg active:bg-white active:text-red-600 transition-all uppercase"><i class="fas fa-shoe-prints -rotate-90 text-3xl md:text-4xl mb-2"></i><span class="text-[11px] md:text-[12px] font-black tracking-tighter">TENDANGAN +2</span></button>
                </div>
            </div>
        </div>
    </div>

    <!-- Audio Effect -->
    <audio id="snd-hit" src="https://assets.mixkit.co/active_storage/sfx/2571/2571-preview.mp3"></audio>

<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import { getDatabase, ref, set, update, onValue } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

    const firebaseConfig = {
        apiKey: "AIzaSyDuC-mjc2LiPQ4Ouiq5DBsMPPad-pPb3h0",
        authDomain: "kejurkot-ambon.firebaseapp.com",
        databaseURL: "https://kejurkot-ambon-default-rtdb.asia-southeast1.firebasedatabase.app",
        projectId: "kejurkot-ambon",
        storageBucket: "kejurkot-ambon.firebasestorage.app",
        messagingSenderId: "545075134619",
        appId: "1:545075134619:web:ec14b7287c636ebd80063e"
    };

    const app = initializeApp(firebaseConfig);
    const database = getDatabase(app);
    const dbRef = ref(database, 'pencak_scoring_state');

    window.state = {};
    window.localJuri = localStorage.getItem('pencak_role_juri') || 0;

    if(window.localJuri && window.localJuri != 0) {
        document.getElementById('screen-juri').classList.add('active');
    } else {
        document.getElementById('screen-juri-select').classList.add('active');
    }

    window.broadcast = function(path = "", value = null) {
        if (path !== "") { const specificRef = ref(database, 'pencak_scoring_state/' + path); set(specificRef, value); }
        else { set(dbRef, window.state); }
    }

    window.checkAllBuffers = function() {
        if (!window.state || !window.state.buffer || !window.state.isRunning) return;
        if (!window.localJuri || window.localJuri == 0) return;

        const myJk = 'j' + window.localJuri;
        let updatesToPush = {}; 
        let hasUpdates = false;

        ['biru', 'merah'].forEach(sudut => {
            ['v1', 'v2'].forEach(valKey => {
                if (!window.state.buffer[sudut] || !window.state.buffer[sudut][valKey]) return;
                const hits = window.state.buffer[sudut][valKey];
                const value = (valKey === 'v1') ? 1 : 2;
                
                let activeJuries = [];
                ['j1', 'j2', 'j3'].forEach(k => {
                    if (hits[k] > 0) activeJuries.push({ jk: k, t: hits[k] });
                });

                if (activeJuries.length >= 2) {
                    activeJuries.sort((a, b) => {
                        if (a.t === b.t) return a.jk.localeCompare(b.jk);
                        return a.t - b.t;
                    });
                    
                    let cluster = [];
                    for (let i = 0; i < activeJuries.length; i++) {
                        cluster = [activeJuries[i]];
                        for (let j = i + 1; j < activeJuries.length; j++) {
                            if (activeJuries[j].t - activeJuries[i].t <= 2000) {
                                cluster.push(activeJuries[j]);
                            }
                        }
                        if (cluster.length >= 2) break; 
                    }

                    if (cluster.length >= 2) {
                        const processor = cluster[cluster.length - 1].jk;
                        
                        if (myJk === processor) {
                            const babakIdx = (window.state.babak || 1) - 1;
                            hasUpdates = true; 
                            
                            cluster.forEach(c => {
                                const jk = c.jk;
                                const currentVal = parseInt(window.state[sudut]?.juri?.[jk]?.[babakIdx] || 0); 
                                const newVal = currentVal + parseInt(value);
                                updatesToPush[`${sudut}/juri/${jk}/${babakIdx}`] = newVal;
                                
                                if (window.state[sudut]?.history?.[jk]?.[babakIdx]) {
                                    let histArr = [...window.state[sudut].history[jk][babakIdx]];
                                    for(let i = histArr.length - 1; i >= 0; i--) {
                                        if(histArr[i].t === c.t && !histArr[i].s) {
                                            histArr[i].s = true;
                                            break;
                                        }
                                    }
                                    updatesToPush[`${sudut}/history/${jk}/${babakIdx}`] = histArr;
                                }

                                updatesToPush[`buffer/${sudut}/${valKey}/${jk}`] = 0;
                            });

                            const freqKey = (value === 1) ? 'pukulanFreq' : 'tendanganFreq'; 
                            const currentFreq = parseInt(window.state[sudut]?.[freqKey] || 0);
                            updatesToPush[`${sudut}/${freqKey}`] = currentFreq + 1;

                            const involvedJks = cluster.map(c => c.jk);
                            updatesToPush[`lastHit`] = { sudut: sudut, time: Date.now(), multiple: involvedJks, type: value };
                            
                            const snd = document.getElementById('snd-hit'); 
                            if(snd) { snd.currentTime = 0; snd.play(); } 
                        }
                    }
                }
            });
        });

        if (hasUpdates) {
            update(dbRef, updatesToPush);
        }
    }

    onValue(dbRef, (snapshot) => {
        const data = snapshot.val();
        if (data) { 
            window.state = data; 
            if(window.checkAllBuffers) window.checkAllBuffers();
            updateUI(); 

            if(window.localJuri && window.state.juriStatus && !window.state.juriStatus['j' + window.localJuri]) {
                if(document.getElementById('screen-juri').classList.contains('active')) {
                    exitJuri(true); 
                }
            }
        }
    });

    window.changeScreen = function(id) { 
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active')); 
        document.getElementById('screen-'+id).classList.add('active'); 
    }

    // Fungsi Toggle Fullscreen/Landscape
    window.toggleLandscape = function() {
        if (!document.fullscreenElement) {
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().then(() => {
                    if (screen.orientation && screen.orientation.lock) {
                        screen.orientation.lock('landscape').catch(e => console.log(e));
                    }
                }).catch(err => {
                    console.log(`Error attempting to enable fullscreen: ${err.message}`);
                });
            }
        } else {
            if (document.exitFullscreen) {
                document.exitFullscreen();
            }
        }
    }

    window.initJuri = function(n) { 
        if(window.state.juriStatus && window.state.juriStatus['j'+n]) { 
            const alertBox = document.getElementById('juri-alert-box'); 
            alertBox.style.opacity = '1'; 
            setTimeout(() => { alertBox.style.opacity = '0'; }, 3000); 
            return; 
        } 
        window.localJuri = n; 
        localStorage.setItem('pencak_role_juri', n); 
        window.broadcast(`juriStatus/j${n}`, true); 
        changeScreen('juri'); 
        
        // Memaksa layar menjadi Fullscreen Landscape secara otomatis (jika diizinkan browser)
        if (document.documentElement.requestFullscreen) {
            document.documentElement.requestFullscreen().then(() => {
                if (screen.orientation && screen.orientation.lock) {
                    screen.orientation.lock('landscape').catch(e => console.log(e)); 
                }
            }).catch(e => console.log("Fullscreen request failed:", e));
        }
        
        updateUI();
    }
    
    window.exitJuri = function(forced = false) { 
        if(window.localJuri) { 
            if(!forced) { window.broadcast(`juriStatus/j${window.localJuri}`, false); }
            window.localJuri = 0; 
            localStorage.removeItem('pencak_role_juri'); 
            if (document.fullscreenElement) {
                document.exitFullscreen().catch(e => console.log(e));
            }
            changeScreen('juri-select'); 
        } 
    }
    
    window.sendHitDirect = function(sudut, value) { 
        if(!window.state.isRunning) return; 
        const now = Date.now(); 
        const juriKey = 'j' + window.localJuri; 
        const babakIdx = (window.state.babak || 1) - 1; 
        const valKey = 'v' + value; 
        
        if(!window.state[sudut]) window.state[sudut] = {};
        if(!window.state[sudut].history) window.state[sudut].history = {};
        if(!window.state[sudut].history[juriKey]) window.state[sudut].history[juriKey] = [[], [], []];
        if(!window.state[sudut].history[juriKey][babakIdx]) window.state[sudut].history[juriKey][babakIdx] = [];
        
        let histArr = [...window.state[sudut].history[juriKey][babakIdx]];
        histArr.push({ v: value, t: now, s: false });
        
        const initialUpdates = {};
        initialUpdates[`${sudut}/history/${juriKey}/${babakIdx}`] = histArr;
        initialUpdates[`buffer/${sudut}/${valKey}/${juriKey}`] = now;
        
        update(dbRef, initialUpdates);
        
        updateUI(); 
        setTimeout(() => updateUI(), 2100);
    }

    window.sendVarVote = function(c) { 
        if(!window.localJuri || window.state.var.votes['j' + window.localJuri]) return; 
        window.broadcast(`var/votes/j${window.localJuri}`, c); 
    }

    window.updateUI = function() {
        if (!window.state || !window.state.matches) return;

        const mb = window.state.bertandingIdx >= 0 ? window.state.matches[window.state.bertandingIdx] : window.state.matches[window.state.idx];
        
        const tStr = (s) => `${Math.floor(s/60).toString().padStart(2,'0')}:${((s||0)%60).toString().padStart(2,'0')}`;
        const timerEl = document.getElementById('jr-timer-disp');
        if (timerEl) timerEl.innerText = tStr(window.state.timer);

        const currentBabak = window.state.babak || 1;
        const roundBadge = document.getElementById('jr-round-badge');
        if (roundBadge) roundBadge.innerText = "BABAK " + currentBabak;

        // Logika Tampil Otomatis Riwayat sesuai Babak Aktif
        const activeBabakIdx = currentBabak - 1;
        for (let i = 0; i < 3; i++) {
            const box = document.getElementById(`hist-box-${i}`);
            if (box) {
                if (i === activeBabakIdx) {
                    box.classList.remove('hidden');
                    box.classList.add('flex');
                } else {
                    box.classList.add('hidden');
                    box.classList.remove('flex');
                }
            }
        }

        if(window.state.juriStatus) { 
            ['j1', 'j2', 'j3'].forEach(j => { 
                const el = document.getElementById('select-lamp-'+j); 
                if(el) { 
                    el.classList.toggle('juri-lamp-green', window.state.juriStatus[j]); 
                    el.classList.toggle('juri-lamp-red', !window.state.juriStatus[j]); 
                } 
            }); 
        }

        if(window.localJuri) {
            const juriKey = 'j' + window.localJuri;

            document.getElementById('jr-role-name').innerText = `JURI ${window.localJuri}`;
            document.getElementById('jr-partai-info').innerText = `PARTAI ${mb.p} / BABAK ${currentBabak} / ${mb.fase} / ${mb.cat} ${mb.kelas} ${mb.gender}`.toUpperCase();
            
            document.getElementById('jr-b-nama-full').innerText = mb.b || "BIRU"; 
            document.getElementById('jr-b-kont-full').innerText = mb.kb || "---";
            document.getElementById('jr-m-nama-full').innerText = mb.m || "MERAH"; 
            document.getElementById('jr-m-kont-full').innerText = mb.km || "---";
            
            const isRunning = window.state.isRunning; 
            ['jr-btn-hit-b1', 'jr-btn-hit-b2', 'jr-btn-hit-m1', 'jr-btn-hit-m2'].forEach(btnId => { 
                const btn = document.getElementById(btnId); 
                if(btn) btn.classList.toggle('jr-hit-btn-off', !isRunning); 
            });

            // Format Riwayat Poin
            const currentTime = Date.now();
            const formatHist = (arr, isBlue) => {
                if (!arr || arr.length === 0) return '-';
                return arr.map(item => {
                    if (typeof item === 'object' && item !== null) {
                        if (item.s) {
                            // Poin Masuk/Sah (Warna Terang + Bold)
                            return `<span class="${isBlue ? 'text-blue-300' : 'text-red-300'} font-black text-[12px] md:text-[14px] drop-shadow-md">${item.v}</span>`;
                        } else {
                            if (currentTime - item.t > 2000) {
                                // Poin Expired/Gagal (Dicoret)
                                return `<span class="${isBlue ? 'text-blue-300/30' : 'text-red-300/30'} line-through decoration-slate-500 decoration-[1.5px]">${item.v}</span>`;
                            } else {
                                // Pending Confirmation (Biasa/Pudar)
                                return `<span class="${isBlue ? 'text-blue-300/80' : 'text-red-300/80'}">${item.v}</span>`;
                            }
                        }
                    } else {
                        return `<span class="${isBlue ? 'text-blue-300' : 'text-red-300'} font-black text-[12px] md:text-[14px] drop-shadow-md">${item}</span>`;
                    }
                }).join('<span class="text-slate-500 font-bold">,</span> ');
            };
            
            // Render riwayat pada UI kolom tengah
            ['biru', 'merah'].forEach(sudut => {
                const isBlue = (sudut === 'biru');
                if (window.state[sudut] && window.state[sudut].history && window.state[sudut].history[juriKey]) {
                    document.getElementById(`hist-mid-${sudut}-0`).innerHTML = formatHist(window.state[sudut].history[juriKey][0], isBlue);
                    document.getElementById(`hist-mid-${sudut}-1`).innerHTML = formatHist(window.state[sudut].history[juriKey][1], isBlue);
                    document.getElementById(`hist-mid-${sudut}-2`).innerHTML = formatHist(window.state[sudut].history[juriKey][2], isBlue);
                } else {
                    document.getElementById(`hist-mid-${sudut}-0`).innerHTML = '-';
                    document.getElementById(`hist-mid-${sudut}-1`).innerHTML = '-';
                    document.getElementById(`hist-mid-${sudut}-2`).innerHTML = '-';
                }
            });

            if (window.state.var && window.state.var.active) { 
                document.getElementById('jr-var-overlay').classList.add('active'); 
                document.getElementById('jr-var-header').innerText = `Partai ${mb.p} ${mb.fase} ${mb.kelas} ${mb.cat} ${mb.gender}`.toUpperCase(); 
                document.getElementById('jr-var-b-name').innerText = mb.b || "BIRU"; 
                document.getElementById('jr-var-b-kont').innerText = mb.kb || "---"; 
                document.getElementById('jr-var-m-name').innerText = mb.m || "MERAH"; 
                document.getElementById('jr-var-m-kont').innerText = mb.km || "---"; 
                
                const v = window.state.var.votes[juriKey]; 
                const container = document.getElementById('jr-vote-container'); 
                
                ['biru', 'merah', 'kuning'].forEach(c => { 
                    const el = document.getElementById(`jr-vote-${c}`); 
                    if(el) { 
                        el.classList.remove('circle-active', 'jr-vote-selected'); 
                        if(v) { 
                            container.classList.add('jr-vote-locked'); 
                            if(v === c) el.classList.add('circle-active', 'jr-vote-selected'); 
                        } else {
                            container.classList.remove('jr-vote-locked'); 
                        }
                    } 
                }); 
            } else {
                document.getElementById('jr-var-overlay').classList.remove('active');
            }
        }
    }
</script>
</body>
</html>
